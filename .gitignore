# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local workspace tooling — AI context files (AGENTS.md, CLAUDE.md, skills) are
# deliberately versioned so the repo carries everything an agent needs.
/.codex/
.claude/settings.local.json

# local Python environments and caches
/.venv/
/.python-version.local
**/__pycache__/
*.py[cod]
.pytest_cache/

# investigation workspace — kept local, not published to this repo.
# The validated release inputs it produces live under public/generated/ and public/maplibre/.
/Fires/

# generated website artifacts are validated release inputs and stay versioned
/test-results/
/playwright-report/
/tmp/

# vendored MapLibre worker, copied from node_modules by scripts/vendor-map-worker.mjs
/public/vendor/
